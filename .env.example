# Supabase-Projekt "system-map" (Ref nfmyezhwwwreqjryxlho, Frankfurt)
VITE_SUPABASE_URL=

# Öffentlicher Client-Key (sb_publishable_…) aus Project Settings → API Keys.
# Niemals der Service-Role-Key – der wird nirgends verwendet.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Adresse, auf die der Magic Link zurückführt. Muss in Supabase unter
# Authentication → URL Configuration als Site URL bzw. Redirect URL stehen.
#   lokal:   http://localhost:5173
#   Vercel:  https://<projekt>.vercel.app
VITE_APP_URL=

# Einzige freigegebene E-Mail-Adresse (Brief A-29). Muss der Zeile in
# public.allowed_email entsprechen; die Datenbank sperrt alles andere.
VITE_ALLOWED_EMAIL=
